{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "./packages/js-toolkit/src",
    "outDir": "dist/dist/",
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": []
  },
  "include": ["packages/js-toolkit/src/**/*.ts"],
  "exclude": [
    "packages/js-toolkit/src/**/*.spec.ts",
    "packages/js-toolkit/src/__utils__/**",
    "packages/js-toolkit/src/__benchmarks__/**"
  ]
}
