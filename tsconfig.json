{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext",
      "dom",
      "dom.iterable",
      "ES2015",
      "ES2016",
      "ES2017",
      "ES2018",
      "ES2019",
      "ES2020"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "paths": {
      "#private/*": ["./packages/js-toolkit/src/*"],
      "#test-utils": ["./packages/js-toolkit/src/__utils__/index.ts"]
    }
  },
  "include": ["packages/js-toolkit/src/**/*.ts"]
}
