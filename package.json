{
  "name": "@studiometa/js-toolkit-workspace",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "demo:dev": "npm run demo:dev -w @studiometa/js-toolkit",
    "demo:build": "npm run demo:build -w @studiometa/js-toolkit",
    "demo:preview": "npm run demo:preview -w @studiometa/js-toolkit",
    "docs:dev": "npm run docs:dev -w @studiometa/js-toolkit",
    "docs:build": "npm run docs:build -w @studiometa/js-toolkit",
    "docs:preview": "npm run docs:preview -w @studiometa/js-toolkit",
    "build": "npm run build:js-toolkit && npm run build:eslint-plugin",
    "build:js-toolkit": "npm run build -w @studiometa/js-toolkit",
    "build:eslint-plugin": "npm run build -w @studiometa/eslint-plugin-js-toolkit",
    "test": "npm run test -w @studiometa/js-toolkit",
    "test:watch": "npm run test:watch -w @studiometa/js-toolkit",
    "test:eslint-plugin": "npm run test -w @studiometa/eslint-plugin-js-toolkit",
    "bench": "npm run bench -w @studiometa/js-toolkit",
    "bench:report": "npm run bench:report -w @studiometa/js-toolkit",
    "lint": "npm run subpaths:check && npm run lint:static && npm run lint:fmt && npm run lint:types",
    "lint:static": "oxlint --ignore-pattern packages/js-toolkit/ . && oxlint --type-aware packages/js-toolkit",
    "lint:fmt": "oxfmt --check .",
    "lint:types": "npm run lint:types --workspaces --if-present",
    "fix": "npm run fix:static && npm run fix:fmt",
    "fix:static": "npm run lint:static -- --fix",
    "fix:fmt": "oxfmt .",
    "postversion": "npm version --workspaces $npm_package_version",
    "subpaths": "node scripts/generate-subpaths.js packages/js-toolkit",
    "subpaths:check": "node scripts/generate-subpaths.js --check packages/js-toolkit",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "patch-package": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
