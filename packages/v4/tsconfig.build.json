{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src"
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "dist",
    "scripts",
    "node_modules",
    "./src/**/*.spec.ts",
    "./src/**/*.bench.ts"
  ]
}
