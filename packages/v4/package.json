{
  "name": "@studiometa/js-toolkit-v4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "v4 prototype — tested in a real browser through Vitest browser mode",
  "exports": {
    ".": {
      "typescript": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "typescript": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "demo:dev": "vite demo --host",
    "demo:build": "vite build demo",
    "demo:preview": "vite preview demo --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest --browser.headless=false",
    "bench": "vitest bench --config vitest.bench.config.js",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-swc": "^0.4.1",
    "@swc/core": "^1.15.47",
    "@vitest/browser": "4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "fast-glob": "3.3.3",
    "playwright": "^1.50.0",
    "tsdown": "0.22.14",
    "vitest": "4.1.2"
  }
}
