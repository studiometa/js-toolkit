{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@studiometa/js-toolkit-v4": ["./src/index.ts"],
      "@studiometa/js-toolkit-v4/utils": ["./src/utils/index.ts"],
      "@studiometa/js-toolkit-v4/utils/*": ["./src/subpaths/utils/*.ts"],
      "@studiometa/js-toolkit-v4/*": ["./src/subpaths/*.ts"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "migration/**/*.ts"],
  "exclude": ["src/coexistence.spec.ts"]
}
